[project]
	description = CIAA-Firmware v2.0.0 development
[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
[access "refs/for/refs/*"]
	read = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	push = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	label-Code-Review = -2..+2 group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	label-Verified = -1..+1 group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	rebase = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	removeReviewer = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	submit = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
[access "refs/heads/*"]
	read = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	create = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	push = +force group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	pushMerge = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
[access "refs/tags/*"]
	push = group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
	push = +force group user/Gustavo Osvaldo Ramoscelli (gramoscelli)
